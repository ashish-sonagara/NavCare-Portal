<%- include('partials/head') %>

<style>
    #nav_2 {
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: white;
    }

    .main_container {
        display: flex;
        justify-content: start;
        padding: 0px;
    }

    .col-md-3 {
        flex-grow: 0;
        flex-shrink: 0;
        flex-basis: 325px;
        max-width: 325px;
    }

    .right_main_container {
        display: flex;
        flex-direction: column;
        padding: 30px 45px;
        background-color: #edf5f1;
        /* min-height: 100vh; */
    }

    /* .patient-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        padding: 35px;
        margin-top: 20px;
    } */

    .section-title {
        color: #147849;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .info-box {
        background: #f8f9fa;
        border: 1px solid #b7d8c5;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 18px;
        min-height: 80px;
    }

    .info-label {
        font-size: 14px;
        color: #147849;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 18px;
        color: #1f2937;
        word-break: break-word;
    }

    .link-btn {
        background-color: white;
        color: #147849;
        border: 1px solid #147849;
        border-radius: 10px;
        padding: 10px 20px;
        transition: 0.3s;
    }

    .link-btn:hover {
        background-color: #147849;
        color: white;
    }

    .no-data {
        text-align: center;
        padding: 50px;
        color: #777;
        font-size: 22px;
    }

    .patient-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    padding: 35px;
    margin-top: 20px;

    max-height: 520px;
    overflow-y: auto;
    overflow-x: hidden;
}
</style>
</head>

<body>
    <%- include('partials/navBar') %>

    <ul class="nav" id="nav_2"
        style="font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
        <h1>Patient Info Access Portal</h1>
    </ul>

    <main class="main">
        <div class="main_container">
            <div class="container-fluid" style="height: 100%;padding: 0px;">
                <div class="row" style="height: 100%;width: 100%;">
                    <%- include('partials/sideBar') %>

                    <div class="col-md-9 right_main_container">
                        <div id="patientContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        let patientData = JSON.parse(sessionStorage.getItem("patientData"));
        let patientContainer = document.getElementById("patientContainer");

        if (!patientData) {
            patientContainer.innerHTML = `
                <div class="patient-card">
                    <div class="no-data">No patient data found in session storage.</div>
                </div>
            `;
        } else {
            patientContainer.innerHTML = `
                <div class="patient-card">
                    <h2 class="section-title">Patient Details</h2>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">First Name</div>
                                <div class="info-value">${patientData.firstname}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Last Name</div>
                                <div class="info-value">${patientData.lastname}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Age</div>
                                <div class="info-value">${patientData.age}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Gender</div>
                                <div class="info-value">${patientData.gender}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Blood Group</div>
                                <div class="info-value">${patientData.blood_group}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Emergency Number</div>
                                <div class="info-value">${patientData.emergency_number}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Email</div>
                                <div class="info-value">${patientData.email}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Hospital Name</div>
                                <div class="info-value">${patientData.hospital_name}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Ward Name</div>
                                <div class="info-value">${patientData.ward_name}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Bed Number</div>
                                <div class="info-value">${patientData.bed_number}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Date & Time</div>
                                <div class="info-value">${patientData.date_n_time}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Condition</div>
                                <div class="info-value">${patientData.condition}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Funds Required</div>
                                <div class="info-value">₹ ${patientData.funds}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-label">Urgency</div>
                                <div class="info-value">${patientData.urgency}</div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="info-box" style="min-height: 120px;">
                                <div class="info-label">Initial Diagnosis</div>
                                <div class="info-value">${patientData.initial_info}</div>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3">
                            <button class="link-btn" onclick="openHospitalLink()">Open Hospital Link</button>
                        </div>
                    </div>
                </div>
            `;
        }

        function openHospitalLink() {
            if (patientData && patientData.hospital_link) {
                window.open(patientData.hospital_link, "_blank");
            } else {
                alert("No hospital link available.");
            }
        }
    </script>
</body>

</html>