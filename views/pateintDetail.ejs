<%- include('partials/head') %>
    <Style>
        #nav_2 {
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Georgia, 'Times New Roman', Times, serif;
            color: white;
        }

        .main_container {
            display: flex;
            justify-content: start;
            padding: 0px;
        }

        .col-md-3 {
            flex-grow: 0;
            flex-shrink: 0;
            flex-basis: 325px;
            max-width: 325px;
        }

        .right_main_container {
            /* height: 100%;
            width: 90%; */
            display: flex;
            flex-direction: column;
            justify-content: space-evenly;
        }
    </Style>
</head>

<body>
    <!-- .............................HEADER SECTION ............................. -->
    <%- include('partials/navBar') %>
        <!-- ........................SECOND NAV BAR........................  -->
        <ul class="nav" id="nav_2"
            style="font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
            <h1>Fill Patient Information</h1>
        </ul>
    </header>
    <!-- .................................MAIN SECTION........................................... -->
    <main class="main">
        <div class="main_container">
            <div class="container-fluid" style="height: 100%;padding: 0px;">
                <div class="row" style="height: 100%;width: 100%;">
                    <%- include('partials/sideBar') %>
                    <div class="col-md-9 right_main_container" style="padding-left: 45px;">
                        <div class="progress_bar">
                            <div id="progress"></div>
                            <div class="progress-steps progress_active" data-title="Basic Information"></div>
                            <div class="progress-steps" data-title="Contact Information"></div>
                            <div class="progress-steps" data-title="Hospital Information"></div>
                            <div class="progress-steps" data-title="Patient Information"></div>
                        </div>

                        <div class="form_container">
                            <form id="patientForm" novalidate style="position: relative;">
                                <!-- THIS IS THE FIRST CONTAINER -->
                                <div class="container">
                                    <div class="row justify-content-between">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;">Basic Information</h4>
                                            <div>
                                                <label for="firstname" class="labels">First Name </label>
                                                <br>
                                                <input type="text" id="name" class="inputs" name="firstname" required
                                                    placeholder="enter the firstname">
                                            </div>
                                            <div>
                                                <label for="age" class="labels">Age </label>
                                                <br>
                                                <input type="number" id="age" name="age" class="inputs" required
                                                    placeholder="enter the assumed age">
                                            </div>
                                            <div class="gender">
                                                <label for="gender" class="labels">Gender </label>
                                                <br>
                                                <label for="male" class="labels">Male </label>
                                                <input type="radio" name="gender" id="male" value="Male"
                                                    style="margin-right: 15px;">
                                                <label for="female" class="labels">Female </label>
                                                <input type="radio" name="gender" id="female" value="Female"
                                                    style="margin-right: 15px;">
                                                <label for="others" class="labels">Others</label>
                                                <input type="radio" name="gender" id="others" value="Others"
                                                    style="margin-bottom: 45px;">
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 49px;">
                                                <label for="lastname" class="labels">Last Name </label>
                                                <br>
                                                <input type="text" id="lastname" class="inputs" name="lastname" required
                                                    placeholder="enter the lastname">
                                            </div>
                                            <div>
                                                <label for="blood_group" class="labels">Blood Group </label>
                                                <br>
                                                <input type="text" id="blood_group" name="blood_group" class="inputs"
                                                    required placeholder="enter the blood group"
                                                    style="margin-bottom: 114px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- THIS IS THE SECOND CONTAINER -->
                                <div class="container">
                                    <div class="row justify-content-between">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;">Contact Information</h4>
                                            <div>
                                                <Label for="emergency_number" class="labels">Emergency Number </Label>
                                                <br>
                                                <input type="number" id="emergency_number" name="emergency_number"
                                                    class="inputs" required placeholder="enter the number ">
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 49px;">
                                                <Label for="email" class="labels">Email </Label>
                                                <br>
                                                <input type="email" id="email" name="email" class="inputs" required
                                                    placeholder="enter email ">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- THIS IS THE THIRD CONTAINER -->
                                <div class="container">
                                    <div class="row justify-content-between">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;">Hospital Information</h4>
                                            <div>
                                                <label for="hospital_name" class="labels">Hospital Name </label>
                                                <br>
                                                <input type="text" id="hospital_name" name="hospital_name"
                                                    class="inputs" required placeholder="enter the hospital name">
                                            </div>
                                            <div>
                                                <label for="ward_name" class="labels">Ward/Block Name : </label>
                                                <br>
                                                <input type="text" id="ward_name" name="ward_name" class="inputs"
                                                    required placeholder="enter the ward block">
                                            </div>
                                            <div>
                                                <label for="date_n_time" class="labels">Date & Time </label>
                                                <br>
                                                <input type="datetime-local" id="date_n_time" name="date_n_time"
                                                    class="inputs">
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 49px;">
                                                <label for="hospital_link" class="labels">Hospital Link </label>
                                                <br>
                                                <input type="text" id="hospital_link" name="hospital_link"
                                                    class="inputs" required
                                                    placeholder="give the link to your hospital!">
                                            </div>
                                            <div>
                                                <label for="bed_num" class="labels">Bed Number : </label>
                                                <br>
                                                <input type="number" id="bed_num" name="bed_number" class="inputs"
                                                    required placeholder="enter the bed number">
                                            </div>
                                            <div>
                                                <label for="condition" class="labels">Current Condition </label>
                                                <br>
                                                <select name="condition" class="inputs" id="condition" required
                                                    style="padding-left: 5px;
                                                font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
                                                    <option value="critical">Critical</option>
                                                    <option value="stable">Stable</option>
                                                    <option value="serious">Serious</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- THIS IS THE LAST CONTAINER -->
                                <div class="container">
                                    <div class="row justify-content-between">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;">Patient Information</h4>
                                            <div>
                                                <label for="funds" class="labels">Estimated Funds Required </label>
                                                <br>
                                                <input type="number" id="funds" name="funds" class="inputs" required
                                                    placeholder="estimated funds required">
                                            </div>
                                            <div>
                                                <label for="initial_info" class="labels">Initial Diagnosis </label>
                                                <br>
                                                <textarea placeholder="Short description of patient’s condition"
                                                    id="initial_info" name="Initial_info" class="inputs" required
                                                    style="height: 125px;padding-top: 0.5rem;"></textarea>
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 49px;">
                                                <label for="urgency" class="labels">Urgency Level </label>
                                                <br>
                                                <select name="Urgency" id="urgency" class="inputs" required
                                                    style="padding-left: 5px;
                                                font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
                                                    <option value="immediate">Immediate</option>
                                                    <option value="Within_24_hours">Within 24 hours</option>
                                                    <option value="normal">Normal</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between"
                                    style="position: absolute; bottom: 2%;left: 1%;width: 100%;">
                                    <button type="button" class="btn btn-outline-success previous"
                                        id="previous">Previous</button>
                                    <button type="button" class="btn btn-outline-success next" id="next">Next</button>
                                    <button type="submit" class="btn btn-outline-success" id="submit">Submit</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
    </main>
    <%- include('partials/footer') %> 
    <script>
        let progressSteps = document.querySelectorAll(".progress-steps");
        let progress = document.getElementById("progress");
        let containers = document.querySelectorAll(".container");
        for (let i = 1; i < containers.length; i++) {
            containers[i].style.display = "none";
        }
        let counter = 0;
        let validation = (counter) => {
            let inputs = containers[counter].querySelectorAll(".inputs");
            for (let input of inputs) {
                if (input.value === "") {
                    alert("Some Feild is Empty");
                    return false;
                }
            }
            return true;
        }

        let previous = document.getElementById("previous");
        previous.disabled = true;

        let next = document.getElementById("next");
        let submit = document.getElementById("submit");

        function updateButton() {
            previous.disabled = (counter === 0);
            next.disabled = (counter === containers.length - 1);
        }

        function nextButton() {
            containers[counter].style.display = "none";
            counter++;
            containers[counter].style.display = "block";
            previous.disabled = false;
        }

        function previousButton() {
            containers[counter].style.display = "none";
            counter--;
            containers[counter].style.display = "block";
            next.style.zIndex = 1;
            submit.style.zIndex = -1;
        }

        function submitButton() {
            if (counter == containers.length - 1) {
                next.style.zIndex = -1;
                submit.style.zIndex = 1;
            }
        }

        next.addEventListener("click", () => {
            if (!validation(counter)) {
                return;
            }
            nextButton();
            updateButton();
            submitButton();
            // console.log(counter);
            switch (counter) {
                case 1:
                    progressSteps[1].classList.add("progress_active");
                    progress.style.width = "33.33%";
                    progress.style.zIndex = 1;
                    break;
                case 2:
                    progressSteps[2].classList.add("progress_active");
                    progress.style.width = "66%";
                    progress.style.zIndex = 1;
                    break;
                case 3:
                    progressSteps[3].classList.add("progress_active");
                    progress.style.width = "100%";
                    progress.style.zIndex = 1;
                    break;
                default:
                    console.log("progress bar filled");
            }

            // if (counter < totalSteps) {
            //     progressSteps[counter].classList.add("progress_active");
            //     progress.style.width = `${(counter / (totalSteps - 1)) * 100}%`;
            //     progress.style.zIndex = 1;
            // }
        })

        previous.addEventListener("click", () => {
            previousButton();
            updateButton();
            // console.log(counter);
            switch (counter) {
                case 0:
                    progressSteps[1].classList.remove("progress_active");
                    progress.style.width = "0";
                    progress.style.zIndex = 1;
                    break;
                case 1:
                    progressSteps[2].classList.remove("progress_active");
                    progress.style.width = "33%";
                    progress.style.zIndex = 1;
                    break;
                case 2:
                    progressSteps[3].classList.remove("progress_active");
                    progress.style.width = "66%";
                    progress.style.zIndex = 1;
                    break;
                default:
                    console.log("progress bar 0");
            }

            // if (counter < totalSteps - 1) {
            //     progressSteps[counter + 1].classList.remove("progress_active");
            //     progress.style.width = `${(counter / (totalSteps - 1)) * 100}%`;
            //     progress.style.zIndex = 1;
            // }
        })

        // submit.addEventListener("click", () => {
        //     alert("Patient Added Successfully");
        //     sessionStorage.setItem("patientData", JSON.stringify(data));
        //     window.location.href = "patient_detail.html";
        // })

    let form = document.getElementById("patientForm");

    form.addEventListener("submit", function (e) {
        // e.preventDefault();
        console.log("method enterded ")

        let data = {
            firstname: document.getElementById("name").value,
            lastname: document.getElementById("lastname").value,
            age: document.getElementById("age").value,
            gender: document.querySelector('input[name="gender"]:checked')?.value || "",
            blood_group: document.getElementById("blood_group").value,

            emergency_number: document.getElementById("emergency_number").value,
            email: document.getElementById("email").value,

            hospital_name: document.getElementById("hospital_name").value,
            hospital_link: document.getElementById("hospital_link").value,
            ward_name: document.getElementById("ward_name").value,
            bed_number: document.getElementById("bed_num").value,
            date_n_time: document.getElementById("date_n_time").value,
            condition: document.getElementById("condition").value,

            funds: document.getElementById("funds").value,
            initial_info: document.getElementById("initial_info").value,
            urgency: document.getElementById("urgency").value
        };
        console.log("data ->", data)
        sessionStorage.setItem("patientData", JSON.stringify(data));

        alert("Patient Added Successfully");

        console.log("Stored Data:", data);

        window.location.href = "/patientDetailForm";
    });

    </script>
</body>

</html>