<%- include('partials/head') %>
    <style>
        #nav_2 {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Georgia, 'Times New Roman', Times, serif;
            color: white;
        }

        .main_container {
            display: flex;
            justify-content: start;
            padding: 0px;
        }

        /*  ACTUALLY THIS IS SIDEBAR STYLE */
        .col-md-3 {
            flex-grow: 0;
            flex-shrink: 0;
            flex-basis: 325px;
            max-width: 325px;
        }

        .right_main_container {
            /* height: 100%;
            width: 90%; */
            display: flex;
            flex-direction: column;
            justify-content: space-evenly;
            padding-left: 4%;
        }
    </style>
</head>

<body>
    <%- include('partials/navBar') %>
        <!-- ........................SECOND NAV BAR........................  -->
        <ul class="nav" id="nav_2"
            style="font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
            <a href="/manageStaff&Accounts" id="back">back</a>
            <h1>Add Staff</h1>
        </ul>
    </header>
    <main>
        <div class="main_container">
            <div class="container-fluid" style="height: 100%;padding: 0px;">
                <div class="row" style="height: 100%;width: 100%;">
                    <%- include('partials/sideBar') %>
                    <div class="col-md-9 right_main_container">
                        <div class="progress_bar">
                            <div id="progress"></div>
                            <div class="progress-steps progress_active" data-title="Staff Information"></div>
                            <div class="progress-steps" data-title="User Credentials"></div>
                            <div class="progress-steps" data-title="Submit Form"></div>
                        </div>
                        <div class="form_container">
                            <form action="/manageStaff&Accounts" method="POST" style="position: relative;">
                                <!-- .................FORM STARTS HERE..................... -->
                                <!-- THIS IS THE FIRST CONTAINER -->
                                <div class="container">
                                    <div class="row">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;">Staff Information</h4>
                                            <div>
                                                <label for="fname" class="labels">First Name </label>
                                                <br>
                                                <input type="text" id="name" class="inputs" name="firstname" required
                                                    placeholder="enter the firstname">
                                            </div>
                                            <div>
                                                <label for="age" class="labels">Age </label>
                                                <br>
                                                <input type="number" id="age" name="age" class="inputs" required
                                                    placeholder="enter the assumed age">
                                            </div>
                                            <div>
                                                <Label for="email" class="labels">Email </Label>
                                                <br>
                                                <input type="email" id="email" name="email" class="inputs" required
                                                    placeholder="enter email ">
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 49px;">
                                                <label for="lname" class="labels">Last Name </label>
                                                <br>
                                                <input type="text" id="lastname" class="inputs" name="lastname" required
                                                    placeholder="enter the lastname">
                                            </div>
                                            <div>
                                                <label for="gender" class="labels">Gender </label>
                                                <br>
                                                <select name="gender" class="inputs" id="gender"
                                                    style=" font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;">
                                                    <option value="Female">Female</option>
                                                    <option value="Male">Male</option>
                                                    <option value="Others">Others</option>
                                                </select>
                                            </div>
                                            <div>
                                                <Label for="contact_number" class="labels">Contact Number </Label>
                                                <br>
                                                <input type="number" id="contact_number" name="contact_number"
                                                    class="inputs" required placeholder="enter the number ">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- THIS IS THE SECOND CONTAINER -->
                                <div class="container">
                                    <div class="row">
                                        <div class="col-md-5">
                                            <h4 style="color: #147849;margin-bottom: 20px;margin-top: 5px;">User
                                                Credentials
                                            </h4>
                                            <div>
                                                <label for="username" class="labels">Username </label>
                                                <br>
                                                <input type="text" id="username" name="username" class="inputs" required
                                                    placeholder="enter Username">
                                            </div>
                                            <h4 style="color: #147849;margin-bottom: 20px;">Admin Authorization</h4>
                                            <div>
                                                <label for="admin_pass" class="labels">Admin Password </label>
                                                <br>
                                                <input type="password" id="admin_pass" name="admin_pass" class="inputs"
                                                    required placeholder="Enter Admin Password">
                                            </div>
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-5">
                                            <div style="margin-top: 50px;">
                                                <label for="pass" class="labels">Password </label>
                                                <br>
                                                <input type="password" id="pass" name="pass" class="inputs" required
                                                    placeholder="enter password">
                                            </div>
                                            <div style="margin-top: 50px;">
                                                <label for="id" class="labels">Staff ID </label>
                                                <br>
                                                <input type="number" id="id" name="id" class="inputs" required
                                                    placeholder="Give Staff ID for Security">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between"
                                    style="position: absolute; bottom: 2%;left: 1%;width: 100%;">
                                    <button type="button" class="btn btn-outline-success previous"
                                        id="previous">Previous</button>
                                    <button type="button" class="btn btn-outline-success next" id="next">Next</button>
                                    <button type="submit" class="btn btn-outline-success" id="submit">Submit</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>   
    <script>
        let progress = document.getElementById("progress");
        let container1 = document.getElementsByClassName("container")[0];
        let container2 = document.getElementsByClassName("container")[1];
        container2.style.display = "none";

        let previous = document.getElementById("previous");
        let next = document.getElementById("next");
        let submit = document.getElementById("submit");
        let counter = 1;

        //FORM VALIDATION FOR ONCLICK NEXT BUTTON
        function validation() {
            // if class container already stored in the var then u can use it like this instead of document
            let inputs = container1.querySelectorAll(".inputs");
            for (let input of inputs) {
                // console.log("ashishssss");
                if (input.value === "") {
                    alert("Some Feild is Empty");
                    return false;
                }
            }
            return true;
        }

        function validation2() {
            // if class container already stored in the var then u can use it like this instead of document
            let inputs2 = container2.querySelectorAll(".inputs");
            for (let input of inputs2) {
                // console.log("ashishssss");
                if (input.value === "") {
                    alert("Some Feild is Empty");
                    return false;
                }
            }
            return true;
        }

        next.addEventListener("click", () => {
            // converts like we got false and if condition runs only if it is true so we use uesdd !
            if (!validation()) {
                return;
            }
            container1.style.display = "none";
            container2.style.display = "block";
            submit.style.zIndex = 1;
            next.style.zIndex = -1;
            previous.disabled = false;
            if (counter == 1) {
                counter++;
                document.getElementsByClassName("progress-steps")[1].classList.add("progress_active");
                progress.style.width = "50%";
                progress.style.zIndex = 1;
            }
        })

        previous.addEventListener("click", () => {
            console.log("previuse click");
            container1.style.display = "block";
            container2.style.display = "none";
            submit.style.zIndex = -1;
            next.style.zIndex = 1;
            if (counter == 2) {
                counter--;
                document.getElementsByClassName("progress-steps")[1].classList.remove("progress_active");
                progress.style.width = "0";
                previous.disabled = true;
            }
            if (counter == 3) {
                counter--;
                document.getElementsByClassName("progress-steps")[2].classList.remove("progress_active");
                progress.style.width = "50%";
            }
        })

        submit.addEventListener("click", () => {
            if (!validation2()) {
                return;
            }
            if (counter == 2) {
                counter++;
                document.getElementsByClassName("progress-steps")[2].classList.add("progress_active");
                progress.style.width = "100%";
            }
            console.log("submitted");
            alert("Pateint successfully added!");
            window.location.href = "/manageStaff&Accounts";
        })

        if (container1.style.display != "none") {
            previous.disabled = true;
        }
        // validation();
    </script>
</body>

</html>